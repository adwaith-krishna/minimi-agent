# ==============================================================================
# Model Providers (Set at least ONE model provider key)
# The agent automatically detects which provider is configured.
# Priority: OPENAI -> GEMINI -> ANTHROPIC -> GROQ -> OPENAI_COMPATIBLE
# ==============================================================================

# OpenAI (default model: gpt-4o or gpt-4o-mini)
OPENAI_API_KEY=

# Google Gemini (default model: gemini-2.0-flash or gemini-1.5-pro)
GEMINI_API_KEY=

# Anthropic (default model: claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022)
ANTHROPIC_API_KEY=

# Groq (default model: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_API_KEY=

# Custom OpenAI-compatible endpoint (optional, e.g., Ollama, vLLM, OpenRouter)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=llama3.1

# ==============================================================================
# Web Search Providers (Optional but recommended for production accuracy)
# If NO search key is provided, the agent automatically uses its built-in
# DuckDuckGo web search engine with clean scraping & parsing (Zero-Config fallback).
# ==============================================================================

# Tavily AI Search API (Recommended: https://tavily.com - free tier available)
TAVILY_API_KEY=

# Brave Search API (Alternative: https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Serper.dev Google Search API (Alternative: https://serper.dev)
SERPER_API_KEY=

# ==============================================================================
# Agent Settings (Optional overrides)
# ==============================================================================
# DEFAULT_MODEL=gpt-4o-mini
# MAX_SEARCH_RESULTS_PER_QUERY=5
# SEARCH_DEEP_READ_TOP_N=2
# PORT=3000
